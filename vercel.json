{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/credlyr run build",
  "outputDirectory": "artifacts/credlyr/dist/public",
  "functions": {
    "api/*.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/status",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/customers/reviews",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/customers/partners",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/customers/community",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/careers",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/security",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/trust",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/resources-hub",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/resources-hub/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/brand-strategy",
      "destination": "/industries/advisory",
      "permanent": true
    },
    {
      "source": "/services/visual-identity",
      "destination": "/product/websites",
      "permanent": true
    },
    {
      "source": "/services/optimisation",
      "destination": "/product/websites",
      "permanent": true
    },
    {
      "source": "/industries/spas",
      "destination": "/industries/aesthetics",
      "permanent": true
    },
    {
      "source": "/industries/home-services",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/industries/real-estate",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
